{
  "manifest_version": 3,
  "name": "OZZO Sender",
  "version": "1.1.0",
  "description": "Sends one OZZO outreach message, with its attachments, at a time through WhatsApp Web. Founder-only.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app.ozzo.co.in/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/wppconnect-wa.js", "page-shim.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
